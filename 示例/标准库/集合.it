# 列表和字典的常用操作类库。

初始化:
    返回 空

长度 集合:
    返回 集合.长度()

追加 列表 项:
    返回 追加(列表, 项)

删除 列表 索引:
    返回 删除(列表, 索引)

反转 列表:
    结果 = []
    索引 = 列表.长度() - 1
    循环 索引 >= 0:
        追加(结果, 列表[索引])
        索引 = 索引 - 1
    返回 结果

去重 列表:
    结果 = []
    索引 = 0
    循环 索引 < 列表.长度():
        项 = 列表[索引]
        已存在 = 假
        检查索引 = 0
        循环 检查索引 < 结果.长度():
            若 结果[检查索引] == 项:
                已存在 = 真
                终止
            检查索引 = 检查索引 + 1
        若 非 已存在:
            追加(结果, 项)
        索引 = 索引 + 1
    返回 结果

排序数字 列表:
    结果 = []
    索引 = 0
    循环 索引 < 列表.长度():
        追加(结果, 列表[索引])
        索引 = 索引 + 1
    索引 = 1
    循环 索引 < 结果.长度():
        当前值 = 结果[索引]
        位置 = 索引
        循环 位置 > 0 且 结果[位置 - 1] > 当前值:
            结果[位置] = 结果[位置 - 1]
            位置 = 位置 - 1
        结果[位置] = 当前值
        索引 = 索引 + 1
    返回 结果

包含列表 列表 项:
    索引 = 0
    循环 索引 < 列表.长度():
        若 列表[索引] == 项:
            返回 真
        索引 = 索引 + 1
    返回 假

字典键 字典:
    返回 字典.键()

字典值 字典:
    返回 字典.值()

字典键值对 字典:
    返回 字典.键值对()

字典包含 字典 键:
    返回 字典.包含(键)

字典删除 字典 键:
    返回 字典.删除(键)
