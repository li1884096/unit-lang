# Unit 基础语法综合示例
# 包含变量、分支、循环、函数、列表、字典、异常和标准库调用。

导入 标准库.字符串 为 字符串类库
导入 标准库.集合 为 集合类库
导入 标准库.数学 为 数学类库
导入 标准库.JSON 为 JSON类库
导入 标准库.时间 为 时间类库

打印("=== 变量与基本类型 ===")
姓名 = "小林"
年龄 = 20
正在学习 = 真
备注 = 空
打印("姓名：" + 姓名)
打印("年龄：" + 转字符串(年龄))
打印("是否正在学习：" + 转字符串(正在学习))
打印("空值类型：" + 类型(备注))

打印("=== 条件分支 ===")
成绩 = 88
等级 = ""
若 成绩 >= 90:
    等级 = "优秀"
~若 成绩 >= 80:
    等级 = "良好"
~:
    等级 = "继续努力"
打印("成绩等级：" + 等级)

打印("=== 函数与循环 ===")
计算平均分 分数列表:
    总分 = 0
    遍历 分数 于 分数列表:
        总分 = 总分 + 分数
    返回 总分 / 分数列表.长度

分数列表 = [85, 92, 78, 96]
平均分 = 计算平均分(分数列表)
打印("平均分：" + 转字符串(平均分))

索引 = 0
循环 索引 < 分数列表.长度:
    打印("第 " + 转字符串(索引 + 1) + " 项：" + 转字符串(分数列表[索引]))
    索引 = 索引 + 1

打印("=== 列表与集合类库 ===")
分数列表.追加(100)
去重结果 = 集合类库().去重([1, 2, 2, 3, 1])
排序结果 = 集合类库().排序数字([9, 3, 7, 1])
打印("追加后的列表长度：" + 转字符串(分数列表.长度))
打印("去重结果：" + 转字符串(去重结果))
打印("排序结果：" + 转字符串(排序结果))

打印("=== 字典操作 ===")
学生 = {"姓名": 姓名, "年龄": 年龄, "平均分": 平均分}
打印("字典姓名：" + 学生.姓名)
打印("字典键：" + 转字符串(学生.键()))
打印("包含年龄键：" + 转字符串(学生.包含("年龄")))
打印("字典长度：" + 转字符串(学生.长度))

打印("=== 字符串与数学类库 ===")
字符串工具 = 字符串类库()
数学工具 = 数学类库()
文本 = "  Unit 编程语言  "
打印("去除空白：" + 字符串工具.去除空白(文本))
打印("替换文本：" + 字符串工具.替换(文本, "Unit", "我的 Unit"))
打印("平方根：" + 转字符串(数学工具.平方根(81)))
打印("圆周率：" + 转字符串(数学工具.圆周率()))

打印("=== JSON 与时间类库 ===")
JSON工具 = JSON类库()
JSON文本 = JSON工具.生成(学生)
解析结果 = JSON工具.解析(JSON文本)
打印("JSON 文本：" + JSON文本)
打印("解析出的姓名：" + 解析结果.姓名)
时间工具 = 时间类库()
打印("当前时间：" + 时间工具.当前时间("年-月-日 时:分:秒"))

打印("=== 异常处理 ===")
尝试:
    抛出 "这是一个演示异常"
捕获 错误:
    打印("捕获到异常：" + 错误.消息)
始终:
    打印("异常处理演示结束")

打印("=== 示例运行完成 ===")
